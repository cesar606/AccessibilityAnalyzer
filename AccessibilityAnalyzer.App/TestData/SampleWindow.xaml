<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finestra de prova">
    <StackPanel>

        <!-- CORRECTE: te nom accessible explicit -->
        <Button AutomationProperties.Name="Cercar" Content="{StaticResource IconaCerca}" />

        <!-- CORRECTE: el contingut textual actua com a nom accessible -->
        <Button Content="Desar" />

        <!-- INCORRECTE (R1): boto nomes amb icona, sense nom accessible -->
        <Button Content="{StaticResource IconaEsborrar}" />

        <!-- INCORRECTE (R1): camp de text sense etiqueta associada -->
        <TextBox Width="200" />

        <!-- INCORRECTE (R1): desplegable sense nom accessible -->
        <ComboBox Width="150" />

        <!-- CORRECTE: casella amb contingut textual -->
        <CheckBox Content="Accepto les condicions" />
		<!-- INCORRECTE (R2): imatge sense alternativa textual -->
		<Image Source="logo.png" Width="100" />

		<!-- CORRECTE (R2): imatge decorativa, exclosa expressament -->
		<Image Source="separador.png" AutomationProperties.AccessibilityView="Raw" />

		<!-- INCORRECTE (R3): nom accessible buit -->
		<Button AutomationProperties.Name="" Content="Enviar" />

		<!-- INCORRECTE (R3): noms duplicats en dos controls diferents -->
		<Button AutomationProperties.Name="Opcions" Content="A" />
		<Button AutomationProperties.Name="Opcions" Content="B" />

		<!-- INCORRECTE (R5): mida de lletra massa petita -->
		<TextBlock Text="Text molt petit" FontSize="8" />

		<!-- Contenidor amb fons blanc declarat -->
		<StackPanel Background="#FFFFFF">

			<!-- INCORRECTE (R4): gris clar sobre blanc, contrast molt baix -->
			<TextBlock Text="Text de baix contrast" Foreground="#AAAAAA" />

			<!-- CORRECTE (R4): negre sobre blanc, contrast maxim -->
			<TextBlock Text="Text ben contrastat" Foreground="#000000" />

			<!-- REVISIO MANUAL (R4): el color prove d'un recurs -->
			<TextBlock Text="Color dinamic" Foreground="{StaticResource ColorText}" />

			<!-- INCORRECTE (R6): boto exclos de la navegacio per teclat -->
			<Button Content="Inaccessible" IsTabStop="False" />

			<!-- INCORRECTE (R7): boto massa petit per ser polsat comodament -->
			<Button Content="X" AutomationProperties.Name="Tancar" Width="16" Height="16" />

			<!-- CORRECTE (R7): boto amb mida suficient -->
			<Button Content="Acceptar" Width="100" Height="32" />

		</StackPanel>

    </StackPanel>
</Window>