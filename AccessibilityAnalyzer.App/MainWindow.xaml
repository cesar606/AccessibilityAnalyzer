<Window x:Class="AccessibilityAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccessibilityAnalyzer.App.Controls"
        Title="Avaluador d'accessibilitat WPF/XAML"
        Height="750" Width="1200"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop">

    <Window.Resources>
        <!-- Estil modern per als botons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10"
                Padding="20,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Opacity="0.08" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoadButton"
                        Content="Carregar fitxer"
                        AutomationProperties.Name="Carregar un fitxer XAML per analitzar"
                        Click="OnLoadFileClick"
                        Style="{StaticResource ModernButton}"
                        Background="#2B5797" Foreground="#FFFFFF" />

                <Button x:Name="LoadFolderButton"
                        Content="Analitzar carpeta"
                        AutomationProperties.Name="Analitzar tots els fitxers XAML d'una carpeta"
                        Click="OnLoadFolderClick"
                        Style="{StaticResource ModernButton}"
                        Background="#2B5797" Foreground="#FFFFFF"
                        Margin="10,0,0,0" />

                <Button x:Name="ExportButton"
                        Content="Exportar HTML"
                        AutomationProperties.Name="Exportar l'informe en format HTML"
                        Click="OnExportClick"
                        IsEnabled="False"
                        Style="{StaticResource ModernButton}"
                        Background="#1E7E45" Foreground="#FFFFFF"
                        Margin="10,0,0,0" />

                <Button x:Name="SettingsButton"
                        Content="&#x2699;  Configuració"
                        AutomationProperties.Name="Obrir la configuració de l'anàlisi"
                        Click="OnSettingsClick"
                        Style="{StaticResource ModernButton}"
                        Background="#E8EBF0" Foreground="#333333"
                        Margin="10,0,0,0" />

                <TextBlock x:Name="FileNameText"
                           Text="Cap fitxer carregat"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"
                           FontSize="14"
                           Foreground="#666666" />

                <Button x:Name="AboutButton"
                        Content="ℹ  Sobre l'eina"
                        AutomationProperties.Name="Informació sobre l'eina i com interpretar els resultats"
                        Click="OnAboutClick"
                        Style="{StaticResource ModernButton}"
                        Background="#E8EBF0" Foreground="#333333"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- CONTINGUT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PANELL ESQUERRE: RESUM -->
            <Border x:Name="SummaryPanel" Grid.Column="0" Background="#FFFFFF" CornerRadius="10"
                    Padding="24" Margin="0,0,16,0"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <StackPanel>

                    <controls:ScoreGauge x:Name="Gauge"
                                         Margin="0,10,0,28"
                                         HorizontalAlignment="Center" />

                    <TextBlock Text="Resum"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1F3864"
                               Margin="0,0,0,14" />

                    <!-- Comptador: errors -->
                    <Border Background="#FEF0F0" CornerRadius="8"
                            Padding="14" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                                       Foreground="#C62828" VerticalAlignment="Center" />
                            <TextBlock x:Name="ErrorCountText"
                                       Text="0 errors"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="#C62828"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Comptador: advertiments -->
                    <Border Background="#FFF8E8" CornerRadius="8"
                            Padding="14" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                                       Foreground="#8A4A10" VerticalAlignment="Center" />
                            <TextBlock x:Name="WarningCountText"
                                       Text="0 advertiments"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="#8A4A10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Comptador: revisions manuals -->
                    <Border Background="#EEF2F9" CornerRadius="8"
                            Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold"
                                       Foreground="#1F3864" VerticalAlignment="Center" />
                            <TextBlock x:Name="ManualCountText"
                                       Text="0 revisions manuals"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="#1F3864"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ManualWarningText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#777777"
                               Margin="0,14,0,0" />

                    <TextBlock x:Name="ElementCountText"
                               Text=""
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,16,0,0" />

                </StackPanel>
            </Border>

            <!-- PANELL DRET: INCIDENCIES -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="IssuesTitle" Grid.Row="0"
                               Text="Incidències detectades"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1F3864"
                               Margin="0,0,0,14"
                               Visibility="Collapsed" />

                    <StackPanel x:Name="WelcomePanel"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Avaluador d'accessibilitat WPF/XAML"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="#1F3864"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Carrega un fitxer XAML o una carpeta per començar, o arrossega'l directament a aquesta finestra."
                                   FontSize="14" Foreground="#888888"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="450"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="IssuesPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>