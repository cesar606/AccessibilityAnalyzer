<Window x:Class="AccessibilityAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccessibilityAnalyzer.App.Controls"
        Title="Avaluador d'accessibilitat WPF/XAML"
        Height="750" Width="1200"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" CornerRadius="10"
                Padding="20,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Opacity="0.08" Color="#000000" />
            </Border.Effect>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoadButton"
                            Content="Carregar fitxer"
                            AutomationProperties.Name="Carregar un fitxer XAML per analitzar"
                            Click="OnLoadFileClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonPrimaryBg}" Foreground="#FFFFFF" />

                    <Button x:Name="LoadFolderButton"
                            Content="Analitzar carpeta"
                            AutomationProperties.Name="Analitzar tots els fitxers XAML d'una carpeta"
                            Click="OnLoadFolderClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonPrimaryBg}" Foreground="#FFFFFF"
                            Margin="10,0,0,0" />

                    <Button x:Name="ExportButton"
                            Content="Exportar HTML"
                            AutomationProperties.Name="Exportar l'informe en format HTML"
                            Click="OnExportClick"
                            IsEnabled="False"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonExportBg}" Foreground="#FFFFFF"
                            Margin="10,0,0,0" />

                    <Button x:Name="ExportJsonButton"
                            Content="Exportar JSON"
                            AutomationProperties.Name="Exportar l'informe en format JSON"
                            Click="OnExportJsonClick"
                            IsEnabled="False"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonExportBg}" Foreground="#FFFFFF"
                            Margin="10,0,0,0" />

                    <Button x:Name="ImportButton"
                            Content="Importar informe"
                            AutomationProperties.Name="Importar un informe JSON desat anteriorment"
                            Click="OnImportClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonSecondaryBg}"
                            Foreground="{DynamicResource ButtonSecondaryFg}"
                            Margin="10,0,0,0" />

                    <Button x:Name="SettingsButton"
                            Content="Configuració"
                            AutomationProperties.Name="Obrir la configuració de l'anàlisi"
                            Click="OnSettingsClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonSecondaryBg}"
                            Foreground="{DynamicResource ButtonSecondaryFg}"
                            Margin="10,0,0,0" />

                    <TextBlock x:Name="FileNameText"
                               Text="Cap fitxer carregat"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}" />

                    <Button x:Name="AboutButton"
                            Content="Sobre l'eina"
                            AutomationProperties.Name="Informació sobre l'eina i com interpretar els resultats"
                            Click="OnAboutClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonSecondaryBg}"
                            Foreground="{DynamicResource ButtonSecondaryFg}"
                            Margin="10,0,0,0" />

                    <Button x:Name="ThemeButton"
                            Content="Mode fosc"
                            AutomationProperties.Name="Canviar entre mode clar i fosc"
                            Click="OnThemeClick"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ButtonSecondaryBg}"
                            Foreground="{DynamicResource ButtonSecondaryFg}"
                            Margin="10,0,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CONTINGUT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PANELL ESQUERRE: RESUM -->
            <Border x:Name="SummaryPanel" Grid.Column="0"
                    Background="{DynamicResource CardBg}" CornerRadius="10"
                    Padding="24" Margin="0,0,16,0"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <StackPanel>

                    <controls:ScoreGauge x:Name="Gauge"
                                         Margin="0,10,0,28"
                                         HorizontalAlignment="Center" />

                    <TextBlock Text="Resum"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeading}"
                               Margin="0,0,0,14" />

                    <!-- Comptador: errors -->
                    <Border Background="{DynamicResource ErrorBg}" CornerRadius="8"
                            Padding="14" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource ErrorColor}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ErrorCountText"
                                       Text="0 errors"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource ErrorColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Comptador: advertiments -->
                    <Border Background="{DynamicResource WarningBg}" CornerRadius="8"
                            Padding="14" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WarningCountText"
                                       Text="0 advertiments"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource WarningColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Comptador: revisions manuals -->
                    <Border Background="{DynamicResource ManualBg}" CornerRadius="8"
                            Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource ManualColor}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ManualCountText"
                                       Text="0 revisions manuals"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource ManualColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ManualWarningText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,14,0,0" />

                    <TextBlock x:Name="ElementCountText"
                               Text=""
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,16,0,0" />

                </StackPanel>
            </Border>

            <!-- PANELL DRET: INCIDENCIES -->
            <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="10"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="IssuesTitle" Grid.Row="0"
                               Text="Incidències detectades"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeading}"
                               Margin="0,0,0,14"
                               Visibility="Collapsed" />

                    <StackPanel x:Name="WelcomePanel"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Avaluador d'accessibilitat WPF/XAML"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextHeading}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Carrega un fitxer XAML o una carpeta per començar, o arrossega'l directament a aquesta finestra."
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="450"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="IssuesPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>