<Window x:Class="AccessibilityAnalyzer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuració de l'anàlisi"
        Height="640" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Idioma -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Idioma / Language:"
                       Width="200" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <ComboBox x:Name="LanguageSelector"
                      Width="160" FontSize="14"
                      SelectionChanged="OnLanguageChanged" />
        </StackPanel>
        
        <TextBlock Grid.Row="1"
                   x:Name="ThresholdsTitle" Text="Llindars d'anàlisi"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#1F3864"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="2"
                   x:Name="ThresholdsDesc" Text="Ajusta els valors mínims que l'eina considerarà acceptables."
                   FontSize="13" Foreground="#555555"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        
        <!-- Mida minima de lletra -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock x:Name="FontSizeLabel" Text="Mida mínima de lletra (px):"
                       Width="200" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <TextBox x:Name="FontSizeInput"
                     AutomationProperties.Name="Mida mínima de lletra en píxels"
                     Width="60" Padding="6,4" FontSize="14"
                     TextChanged="OnPreviewChanged" />
            <Border Background="#F0F0F0" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FontPreview" Text="Exemple"
                           Foreground="#333333" VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <!-- Ratio de contrast -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ContrastLabel" Text="Ràtio mínim de contrast:"
                           Width="200" VerticalAlignment="Center"
                           FontSize="14" Foreground="#333333" />
                <TextBox x:Name="ContrastInput"
                         AutomationProperties.Name="Ràtio mínim de contrast"
                         Width="60" Padding="6,4" FontSize="14"
                         TextChanged="OnPreviewChanged" />
            </StackPanel>

            <Border x:Name="ContrastBox" Background="#FFFFFF" Width="260" Height="46"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    HorizontalAlignment="Left" Margin="200,8,0,0">
                <TextBlock x:Name="ContrastText" Text="Exemple de contrast"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>

        <!-- Mida minima de l'objectiu -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock x:Name="TargetSizeLabel" Text="Mida mínima de l'objectiu (px):"
                       Width="200" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <TextBox x:Name="TargetSizeInput"
                     AutomationProperties.Name="Mida mínima de l'objectiu en píxels"
                     Width="60" Padding="6,4" FontSize="14"
                     TextChanged="OnPreviewChanged" />
            <Border x:Name="TargetPreview"
                    Background="#2E5496" Margin="12,0,0,0" VerticalAlignment="Center"
                    Width="24" Height="24" />
        </StackPanel>

        <!-- Regles actives -->
        <StackPanel Grid.Row="6" Margin="0,4,0,12">
            <TextBlock x:Name="ActiveRulesTitle" Text="Regles actives"
                       FontSize="15" FontWeight="Bold"
                       Foreground="#1F3864"
                       Margin="0,0,0,8" />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RulesList" />
            </ScrollViewer>
        </StackPanel>

        <!-- Botons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResetButton"
                    Content="Restaurar valors per defecte"
                    AutomationProperties.Name="Restaurar els valors per defecte"
                    Click="OnResetClick"
                    Padding="12,8" FontSize="13"
                    Background="#EEEEEE" Foreground="#333333"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Width="149" />
            <Button x:Name="AcceptButton"
                    Content="Acceptar"
                    AutomationProperties.Name="Acceptar la configuració"
                    Click="OnAcceptClick"
                    Padding="16,8" FontSize="13"
                    Background="#2E5496" Foreground="#FFFFFF"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>