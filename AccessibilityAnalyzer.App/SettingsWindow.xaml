<Window x:Class="AccessibilityAnalyzer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuració de l'anàlisi"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Llindars d'anàlisi"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#1F3864"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Ajusta els valors mínims que l'eina considerarà acceptables."
                   FontSize="13" Foreground="#555555"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <!-- Mida minima de lletra -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Mida mínima de lletra (px):"
                       Width="240" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <TextBox x:Name="FontSizeInput"
                     AutomationProperties.Name="Mida mínima de lletra en píxels"
                     Width="80" Padding="6,4" FontSize="14" />
        </StackPanel>

        <!-- Ratio de contrast -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Ràtio mínim de contrast:"
                       Width="240" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <TextBox x:Name="ContrastInput"
                     AutomationProperties.Name="Ràtio mínim de contrast"
                     Width="80" Padding="6,4" FontSize="14" />
        </StackPanel>

        <!-- Mida minima de l'objectiu -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
            <TextBlock Text="Mida mínima de l'objectiu (px):"
                       Width="240" VerticalAlignment="Center"
                       FontSize="14" Foreground="#333333" />
            <TextBox x:Name="TargetSizeInput"
                     AutomationProperties.Name="Mida mínima de l'objectiu en píxels"
                     Width="80" Padding="6,4" FontSize="14" />
        </StackPanel>

        <!-- Botons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResetButton"
                    Content="Restaurar valors per defecte"
                    AutomationProperties.Name="Restaurar els valors per defecte"
                    Click="OnResetClick"
                    Padding="12,8" FontSize="13"
                    Background="#EEEEEE" Foreground="#333333"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" />
            <Button x:Name="AcceptButton"
                    Content="Acceptar"
                    AutomationProperties.Name="Acceptar la configuració"
                    Click="OnAcceptClick"
                    Padding="16,8" FontSize="13"
                    Background="#2E5496" Foreground="#FFFFFF"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>