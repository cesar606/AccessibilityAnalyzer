<UserControl x:Class="AccessibilityAnalyzer.App.Controls.ScoreGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="180">

    <Grid>
        <!-- Cercle de fons -->
        <Ellipse Width="180" Height="180"
                 Stroke="#E8E8E8"
                 StrokeThickness="16" />

        <!-- Arc de progres, dibuixat per codi -->
        <Path x:Name="ProgressArc"
              StrokeThickness="16"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />

        <!-- Puntuacio -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ScoreText"
                       Text="0%"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#1F3864"
                       HorizontalAlignment="Center" />
            <TextBlock Text="accessible"
                       FontSize="14"
                       Foreground="#555555"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>